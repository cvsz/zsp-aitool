{
  "name": "zsp-aitool",
  "version": "0.1.0",
  "private": true,
  "description": "ZSP AI Tool starter app",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "postbuild": "bash scripts/fix-next-server-chunks.sh",
    "test": "vitest run",
    "test:db": "vitest run tests/services/similar-isolation.test.ts",
    "test:all": "npm run test && npm run test:db",
    "test:security": "vitest run tests/security/hyperframes-security.test.ts",
    "health": "bash scripts/health-zsp-aitool.sh",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "hyperframes:doctor": "bash scripts/hyperframes/doctor.sh",
    "hyperframes:worker": "tsx scripts/hyperframes/render-worker.ts",
    "hyperframes:worker:once": "tsx scripts/hyperframes/render-worker.ts --once",
    "hyperframes:render-smoke": "tsx scripts/hyperframes/render-smoke.ts",
    "hyperframes:enqueue-smoke-job": "tsx scripts/hyperframes/enqueue-smoke-job.ts",
    "hyperframes:render-job-status": "tsx scripts/hyperframes/render-job-status.ts",
    "hyperframes:test-render": "bash scripts/hyperframes/test-hyperframes-render.sh",
    "hyperframes:worker:install-service": "bash scripts/hyperframes/install-worker-service.sh",
    "hyperframes:worker:status": "bash scripts/hyperframes/worker-status.sh",
    "hyperframes:worker:logs": "bash scripts/hyperframes/worker-logs.sh",
    "hyperframes:worker:disable-service": "bash scripts/hyperframes/disable-worker-service.sh",
    "hyperframes:queue-status": "tsx scripts/hyperframes/render-queue-status.ts",
    "hyperframes:cleanup-renders": "tsx scripts/hyperframes/cleanup-renders.ts",
    "hyperframes:recover-stale-jobs": "tsx scripts/hyperframes/recover-stale-jobs.ts",
    "hyperframes:worker:trial": "bash scripts/hyperframes/worker-trial.sh",
    "hyperframes:worker:live-trial": "bash scripts/hyperframes/live-queue-trial.sh",
    "hyperframes:worker:preflight": "bash scripts/hyperframes/persistent-worker-preflight.sh",
    "hyperframes:worker:enable-real": "bash scripts/hyperframes/enable-real-worker-daemon.sh",
    "hyperframes:worker:disable-real": "bash scripts/hyperframes/disable-real-worker-daemon.sh",
    "hyperframes:worker:watchdog": "tsx scripts/hyperframes/worker-watchdog.ts",
    "hyperframes:worker:journal-summary": "bash scripts/hyperframes/worker-journal-summary.sh",
    "hyperframes:diag": "bash scripts/hyperframes/diag.sh",
    "hyperframes:safe-rollback": "bash scripts/hyperframes/safe-rollback.sh",
    "hyperframes:worker:install-log-policy": "bash scripts/hyperframes/install-worker-log-policy.sh",
    "hyperframes:ci:mock": "bash scripts/hyperframes/ci-mock.sh",
    "hyperframes:ci:real": "bash scripts/hyperframes/ci-real.sh",
    "hyperframes:render-inventory": "tsx scripts/hyperframes/render-inventory.ts",
    "hyperframes:worker:alerts": "tsx scripts/hyperframes/worker-alerts.ts",
    "hyperframes:worker:install-alert-timer": "bash scripts/hyperframes/install-worker-alert-timer.sh",
    "hyperframes:cleanup:install-timer": "bash scripts/hyperframes/install-cleanup-timer.sh",
    "hyperframes:cleanup:disable-timer": "bash scripts/hyperframes/disable-cleanup-timer.sh",
    "hyperframes:cleanup:status": "bash scripts/hyperframes/cleanup-timer-status.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "15.5.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.18",
    "jsdom": "^25.0.1",
    "postcss": "8.5.10",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.5.4",
    "vitest": "^4.1.6"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "overrides": { "postcss": "$postcss" }
}
