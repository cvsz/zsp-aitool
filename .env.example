# App
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=zsp-aitool
NEXT_PUBLIC_APP_URL=https://studio.zeaz.dev
# NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=https://studio.zeaz.dev/api
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Auth
AUTH_SECRET=replace-with-a-strong-random-secret
DEFAULT_USER_EMAIL=demo@zsp.local

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zsp_aitool?schema=public

# Prisma
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zsp_aitool_shadow?schema=public

# AI Provider (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Usage Guard / Budget
AI_DAILY_BUDGET_USD=20
AI_MAX_REQUESTS_PER_MINUTE=30
OCR_MAX_REQUESTS_PER_MINUTE=20

# HyperFrames Render Worker (optional)
HYPERFRAMES_RENDER_ENABLED=false
HYPERFRAMES_WORKDIR=/var/lib/zsp-aitool/hyperframes
HYPERFRAMES_OUTPUT_DIR=/var/lib/zsp-aitool/hyperframes/renders
HYPERFRAMES_MAX_DURATION_SECONDS=60
HYPERFRAMES_MAX_CONCURRENT_JOBS=1
HYPERFRAMES_NODE_BIN=node
HYPERFRAMES_FFMPEG_BIN=ffmpeg
HYPERFRAMES_CLI_BIN=hyperframes
